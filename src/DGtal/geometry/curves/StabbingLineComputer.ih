///////////////////////////////////////////////////////////////////////////////
// IMPLEMENTATION of inline methods.
///////////////////////////////////////////////////////////////////////////////

///////////////////////////////////////////////////////////////////////////////
// ----------------------- Standard services ------------------------------

template <typename TConstIterator, typename TCategory>
inline
DGtal::StabbingLineComputer<TConstIterator,TCategory>::StabbingLineComputer()
:myBegin(), myEnd(), myPreimagePtr(), myFlagIsInit(false), myFlagIsCW(true)
{
}

template <typename TConstIterator, typename TCategory>
inline
DGtal::StabbingLineComputer<TConstIterator,TCategory>::StabbingLineComputer( const Self& other )
:myBegin(other.myBegin), myEnd(other.myEnd), myPreimagePtr(other.myPreimagePtr),
myFlagIsInit(other.myFlagIsInit), myFlagIsCW(other.myFlagIsCW)
{
}

template <typename TConstIterator, typename TCategory>
inline
typename DGtal::StabbingLineComputer<TConstIterator,TCategory>::Self&
DGtal::StabbingLineComputer<TConstIterator,TCategory>::operator= ( const Self& other )
{
  if ( this != &other )
  {
    myBegin = other.myBegin;
    myEnd = other.myEnd;
    myPreimagePtr = other.myPreimagePtr;
    myFlagIsInit = other.myFlagIsInit;
    myFlagIsCW = other.myFlagIsCW;
  }
  return *this;
}

template <typename TConstIterator, typename TCategory>
inline
DGtal::StabbingLineComputer<TConstIterator,TCategory>::~StabbingLineComputer()
{
}

template <typename TConstIterator, typename TCategory>
inline
bool
DGtal::StabbingLineComputer<TConstIterator,TCategory>::operator==( const Self& other ) const
{
  if (isValid()&&other.isValid())
  {
    Pair firstPair( *myBegin );
    Pair oFirstPair( *(other.myBegin) );
    if ( (firstPair.first == oFirstPair.first)
       &&(firstPair.second == oFirstPair.second) )
    {
      ConstIterator it (myEnd);
      --it;
      Pair lastPair( *it );
      ConstIterator oIt (other.myEnd);
      --oIt;
      Pair oLastPair( *oIt );

      if ( (lastPair.first == oLastPair.first)
         &&(lastPair.second == oLastPair.second) )
      {
        return ( *myPreimagePtr == *(other.myPreimagePtr) );
      }
      else return false;
    }
    else return false;
  }
  else
  {
    return ( (!isValid()) && (!other.isValid()) );
  }
}

template <typename TConstIterator, typename TCategory>
inline
bool
DGtal::StabbingLineComputer<TConstIterator,TCategory>::operator!=( const Self& other ) const
{
  return !(*this == other);
}

template <typename TConstIterator, typename TCategory>
inline
typename DGtal::StabbingLineComputer<TConstIterator,TCategory>::Reverse
DGtal::StabbingLineComputer<TConstIterator,TCategory>::getReverse() const
{
  return Reverse();
}


template <typename TConstIterator, typename TCategory>
inline
typename DGtal::StabbingLineComputer<TConstIterator,TCategory>::Self
DGtal::StabbingLineComputer<TConstIterator,TCategory>::getSelf() const
{
  return Self();
}



///////////////////////////////////////////////////////////////////////////////
// Interface - public :

template <typename TConstIterator, typename TCategory>
inline
bool
DGtal::StabbingLineComputer<TConstIterator,TCategory>::isValid() const
{
  if ( myPreimagePtr.get() != 0 )
  {
    return myPreimagePtr->isValid();
  }
  else
  {
    return false;
  }
}

template <typename TConstIterator, typename TCategory>
inline
typename DGtal::StabbingLineComputer<TConstIterator,TCategory>::ConstIterator
DGtal::StabbingLineComputer<TConstIterator,TCategory>::begin() const
{
  return myBegin;
}

template <typename TConstIterator, typename TCategory>
inline
typename DGtal::StabbingLineComputer<TConstIterator,TCategory>::ConstIterator
DGtal::StabbingLineComputer<TConstIterator,TCategory>::end() const
{
  return myEnd;
}

template <typename TConstIterator, typename TCategory>
inline
typename DGtal::StabbingLineComputer<TConstIterator,TCategory>::Point
DGtal::StabbingLineComputer<TConstIterator,TCategory>::Uf() const
{
  ASSERT( myPreimagePtr.get() != 0 );
  return myPreimagePtr->Uf();
}

template <typename TConstIterator, typename TCategory>
inline
typename DGtal::StabbingLineComputer<TConstIterator,TCategory>::Point
DGtal::StabbingLineComputer<TConstIterator,TCategory>::Ul() const
{
  ASSERT( myPreimagePtr.get() != 0 );
  return myPreimagePtr->Ul();
}

template <typename TConstIterator, typename TCategory>
inline
typename DGtal::StabbingLineComputer<TConstIterator,TCategory>::Point
DGtal::StabbingLineComputer<TConstIterator,TCategory>::Lf() const
{
  ASSERT( myPreimagePtr.get() != 0 );
  return myPreimagePtr->Lf();
}

template <typename TConstIterator, typename TCategory>
inline
typename DGtal::StabbingLineComputer<TConstIterator,TCategory>::Point
DGtal::StabbingLineComputer<TConstIterator,TCategory>::Ll() const
{
  ASSERT( myPreimagePtr.get() != 0 );
  return myPreimagePtr->Ll();
}


template <typename TConstIterator, typename TCategory>
inline
typename DGtal::StabbingLineComputer<TConstIterator,TCategory>::PreimagePtr
DGtal::StabbingLineComputer<TConstIterator,TCategory>::getPreimage() const
{
  ASSERT( myPreimagePtr.get() != 0 );
  return myPreimagePtr;
}


template <typename TConstIterator, typename TCategory>
inline
bool
DGtal::StabbingLineComputer<TConstIterator,TCategory>::isClockwiseOriented() const
{
  return myFlagIsCW;
}


template <typename TConstIterator, typename TCategory>
inline
void
DGtal::StabbingLineComputer<TConstIterator,TCategory>::getParameters(double& alpha, double& beta, double& gamma) const
{
  ASSERT( myPreimagePtr.get() != 0 );
  myPreimagePtr->getSeparatingStraightLine(alpha, beta, gamma);
}

template <typename TConstIterator, typename TCategory>
inline
void
DGtal::StabbingLineComputer<TConstIterator,TCategory>::projects(double& x, double& y,
                const double& alpha, const double& beta, const double& gamma) const
{
  ASSERT( (alpha!=0)||(beta!=0) );
  double d2 = ( alpha * alpha + beta * beta );
  double s = beta*x - alpha*y;
  x = (beta*s - alpha*gamma)/d2;
  y = -(alpha*s + beta*gamma)/d2;
}

///////////////////////////////////////////////////////////////////////////////
// Growth operations                                                        //

template <typename TConstIterator, typename TCategory>
inline
void
DGtal::StabbingLineComputer<TConstIterator,TCategory>::init(const ConstIterator& anIt)
{
  myBegin = anIt;
  myEnd = anIt;
  ++myEnd;
  Pair aPair( *anIt);
  myPreimagePtr = PreimagePtr( new Preimage( aPair.first, aPair.second, StraightLine() ) );
}

template <typename TConstIterator, typename TCategory>
inline
bool
DGtal::StabbingLineComputer<TConstIterator,TCategory>::isConcave()
{
  ASSERT( myPreimagePtr.get() != 0 );
  Pair aPair( *myEnd );
  bool isExterior = false;

  if (myFlagIsInit)
  { //initialized

    if (myFlagIsCW)
      isExterior = myPreimagePtr->isLeftExteriorAtTheFront( aPair.first, aPair.second );
    else
      isExterior = myPreimagePtr->isRightExteriorAtTheBack( aPair.first, aPair.second );

  }

  return isExterior;
}

template <typename TConstIterator, typename TCategory>
inline
bool
DGtal::StabbingLineComputer<TConstIterator,TCategory>::isConvex()
{
  ASSERT( myPreimagePtr.get() != 0 );
  Pair aPair( *myEnd );
  bool isExterior = false;

  if (myFlagIsInit)
  { //initialized

    if (myFlagIsCW)
      isExterior = myPreimagePtr->isRightExteriorAtTheFront( aPair.first, aPair.second );
    else
      isExterior = myPreimagePtr->isLeftExteriorAtTheBack( aPair.first, aPair.second );

  }

  return isExterior;
}

template <typename TConstIterator, typename TCategory>
inline
bool
DGtal::StabbingLineComputer<TConstIterator,TCategory>::isOppositeEndConcave()
{
  ASSERT( myPreimagePtr.get() != 0 );
  ConstIterator it( myBegin );
  --it;
  Pair aPair( *it );
  bool isExterior = false;

  if (myFlagIsInit)
  { //initialized

    if (myFlagIsCW)
      isExterior = myPreimagePtr->isRightExteriorAtTheBack( aPair.first, aPair.second );
    else
      isExterior = myPreimagePtr->isLeftExteriorAtTheFront( aPair.first, aPair.second );

  }

  return isExterior;
}

template <typename TConstIterator, typename TCategory>
inline
bool
DGtal::StabbingLineComputer<TConstIterator,TCategory>::isOppositeEndConvex()
{
  ASSERT( myPreimagePtr.get() != 0 );
  ConstIterator it( myBegin );
  --it;
  Pair aPair( *it );
  bool isExterior = false;

  if (myFlagIsInit)
  { //initialized

    if (myFlagIsCW)
      isExterior = myPreimagePtr->isLeftExteriorAtTheBack( aPair.first, aPair.second );
    else
      isExterior = myPreimagePtr->isRightExteriorAtTheFront( aPair.first, aPair.second );

  }

  return isExterior;
}


template <typename TConstIterator, typename TCategory>
inline
bool
DGtal::StabbingLineComputer<TConstIterator,TCategory>::isExtendableFront()
{
  ASSERT( myPreimagePtr.get() != 0 );
  Pair aPair( *myEnd );
  bool isOK = false;

  if (myFlagIsInit)
  { //initialized

    if (myFlagIsCW)
      isOK = myPreimagePtr->canBeAddedAtTheFront( aPair.first, aPair.second );
    else
      isOK = myPreimagePtr->canBeAddedAtTheBack( aPair.first, aPair.second );

  } else
  { //not initialized yet
    if ( myPreimagePtr->canBeAddedAtTheFront( aPair.first, aPair.second ) )
      isOK = true;
    else if ( myPreimagePtr->canBeAddedAtTheBack( aPair.first, aPair.second ) )
      isOK = true;
  }

  return isOK;
}

template <typename TConstIterator, typename TCategory>
inline
bool
DGtal::StabbingLineComputer<TConstIterator,TCategory>::extendFront()
{
  ASSERT( myPreimagePtr.get() != 0 );
  Pair aPair( *myEnd );
  bool isOK = false;

  if (myFlagIsInit)
  { //initialized

    if (myFlagIsCW)
      isOK = myPreimagePtr->addFront( aPair.first, aPair.second );
    else
      isOK = myPreimagePtr->addBack( aPair.first, aPair.second );

  } else
  { //not initialized yet
    if ( myPreimagePtr->addFront( aPair.first, aPair.second ) )
    {
      myFlagIsCW = true;
      isOK = true;
    }
    else if ( myPreimagePtr->addBack( aPair.first, aPair.second ) )
    {
      myFlagIsCW = false;
      isOK = true;
    }
    myFlagIsInit = true;
  }

  if (isOK)
  {
    ++myEnd;
    return true;
  } else return false;
}

template <typename TConstIterator, typename TCategory>
inline
bool
DGtal::StabbingLineComputer<TConstIterator,TCategory>::isExtendableBack()
{
  ASSERT( myPreimagePtr.get() != 0 );
  ConstIterator it( myBegin );
  --it;
  Pair aPair( *it );
  bool isOK = false;

  if (myFlagIsInit)
  { //initialized

    if (myFlagIsCW)
      isOK = myPreimagePtr->canBeAddedAtTheBack( aPair.first, aPair.second );
    else
      isOK = myPreimagePtr->canBeAddedAtTheFront( aPair.first, aPair.second );

  } else
  { //not initialized yet
    if ( myPreimagePtr->canBeAddedAtTheBack( aPair.first, aPair.second ) )
      isOK = true;
    else if ( myPreimagePtr->canBeAddedAtTheFront( aPair.first, aPair.second ) )
      isOK = true;
  }

  return isOK;
}

template <typename TConstIterator, typename TCategory>
inline
bool
DGtal::StabbingLineComputer<TConstIterator,TCategory>::extendBack()
{
  ASSERT( myPreimagePtr.get() != 0 );
  ConstIterator it( myBegin );
  --it;
  Pair aPair( *it );
  bool isOK = false;

  if (myFlagIsInit)
  { //initialized

    if (myFlagIsCW)
      isOK = myPreimagePtr->addBack( aPair.first, aPair.second );
    else
      isOK = myPreimagePtr->addFront( aPair.first, aPair.second );

  } else
  { //not initialized yet
    if ( myPreimagePtr->addBack( aPair.first, aPair.second ) )
    {
      myFlagIsCW = true;
      isOK = true;
    }
    else if ( myPreimagePtr->addFront( aPair.first, aPair.second ) )
    {
      myFlagIsCW = false;
      isOK = true;
    }
    myFlagIsInit = true;
  }

  if (isOK)
  {
    myBegin = it;
    return true;
  } else return false;
}

///////////////////////////////////////////////////////////////////////////////
// Display :

template <typename TConstIterator, typename TCategory>
inline
void
DGtal::StabbingLineComputer<TConstIterator,TCategory>::selfDisplay ( std::ostream & out ) const
{
  out << std::endl;
  out << "[StabbingLineComputer]" << std::endl;
  if (isValid())
  {
    Pair firstPair( *myBegin );
    out << "\t From " << firstPair.first << firstPair.second << std::endl;
    ConstIterator it (myEnd);
    --it;
    Pair lastPair( *it );
    out << "\t To " << lastPair.first << lastPair.second << std::endl;
    ASSERT( myPreimagePtr.get() != 0 );
    out << (*myPreimagePtr);
  }
  else
  {
    out << "\t not valid" << std::endl;
  }
  out << "[end of StabbingLineComputer]" << std::endl;
}

template <typename TConstIterator, typename TCategory>
inline
std::string
DGtal::StabbingLineComputer<TConstIterator,TCategory>::className() const
{
  return "StabbingLineComputer";
}

///////////////////////////////////////////////////////////////////////////////
// Implementation of inline functions                                        //

template <typename TConstIterator, typename TCategory>
inline
std::ostream&
DGtal::operator<< ( std::ostream & out,
		  const StabbingLineComputer<TConstIterator,TCategory> & object )
{
  object.selfDisplay( out );
  return out;
}


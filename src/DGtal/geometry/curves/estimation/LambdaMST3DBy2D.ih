namespace DGtal
{
  inline
  TangentFromDSS3DBy2DFunctor::Vector3D
  TangentFromDSS3DBy2DFunctor::operator() ( MAIN_AXIS mainAxis, const Vector2D & v0, const Vector2D & v1 ) const
  {
    Vector3D tangent;
    if ( mainAxis == X )
    {
      if ( v1[1] == 0 || ( v0[0] == 0 && v1[0] == 0 ) )
      {
        tangent[0] = v0[0];
        tangent[1] = v0[1];
        tangent[2] = v1[1];
      }
      else
      {
        if ( v0[1] == 0 )
        {
          tangent[0] = v1[0];
          tangent[1] = 0;
          tangent[2] = v1[1];
        }
        else
        {
          tangent[0] = v1[0] * v0[0];
          tangent[1] = v1[0] * v0[1];
          tangent[2] = v0[0] * v1[1];
        }
      }
    }
    else if ( mainAxis == Y )
    {
      if ( v0[0] == 0 || ( v1[0] == 0 && v0[1] == 0 ) )
      {
        tangent[0] = v0[0];
        tangent[1] = v1[0];
        tangent[2] = v1[1];
      }
      else
      {
        if ( v1[1] == 0 )
        {
          tangent[0] = v0[0];
          tangent[1] = v0[1];
          tangent[2] = 0;
        }
        else
        {
          tangent[0] = v1[0] * v0[0];
          tangent[1] = v1[0] * v0[1];
          tangent[2] = v0[1] * v1[1];
        }
      }
    }
    else
    {
      if ( v0[0] == 0 || ( v0[1] == 0 && v1[1] == 0 ) )
      {
        tangent[0] = v0[0];
        tangent[1] = v1[0];
        tangent[2] = v1[1];
      }
      else
      {
        if ( v1[0] == 0 )
        {
          tangent[0] = v0[0];
          tangent[1] = 0;
          tangent[2]= v0[1];
        }
        else
        {
          tangent[0] = v0[0] * v1[1];
          tangent[1] = v1[0] * v0[1];
          tangent[2] = v0[1] * v1[1];
        }
      }
    }
    // The branches above give the same direction but different lengths: the
    // general branch is scaled by the product of the two 2D components along
    // the main axis (for X, v0[0] * v1[0] times (1, v0[1] / v0[0], v1[1] / v1[0])),
    // the branches taken when a component is exactly zero are not. The
    // result is normalized so that it is the unit tangent v / |v| whichever
    // branch was taken.
    const double norm = tangent.norm ( );
    if ( norm != 0. )
      tangent /= norm;
    return tangent;
  }


  template < typename Iterator3D, typename Functor, typename LambdaFunctor, int CONNECTIVITY >
  inline
  LambdaMST3DBy2DEstimator< Iterator3D, Functor, LambdaFunctor, CONNECTIVITY >::LambdaMST3DBy2DEstimator()
    : myCoreBegin(), myCoreEnd(), myBegin(), myEnd()
  {
    //projections
    std::vector < Dimension > v1, v2, v3;
    v1.push_back ( 0 );
    v1.push_back ( 1 );
    v2.push_back ( 0 );
    v2.push_back ( 2 );
    v3.push_back ( 1 );
    v3.push_back ( 2 );
    myProjXY.init ( v1.begin ( ), v1.end ( ) );
    myProjXZ.init ( v2.begin ( ), v2.end ( ) );
    myProjYZ.init ( v3.begin ( ), v3.end ( ) );
  }

  // The two projections used for a main axis are the two planes containing
  // it: X -> (XY, XZ), Y -> (XY, YZ), Z -> (XZ, YZ), the order
  // TangentFromDSS3DBy2DFunctor expects.
  template < typename Iterator3D, typename Functor, typename LambdaFunctor, int CONNECTIVITY >
  inline
  void
  LambdaMST3DBy2DEstimator< Iterator3D, Functor, LambdaFunctor, CONNECTIVITY >::init ( Iterator3D itB, Iterator3D itE,
                                                                                        Iterator3D extB, Iterator3D extE,
                                                                                        MAIN_AXIS axis )
  {
    ASSERT ( extB <= itB && itB < itE && itE <= extE );
    myCoreBegin = itB;
    myCoreEnd = itE;
    myBegin = extB;
    myEnd = extE;
    myAxis = axis;
    myProj1 = ( axis == MAIN_AXIS::Z ) ? myProjXZ : myProjXY;
    myProj2 = ( axis == MAIN_AXIS::X ) ? myProjXZ : myProjYZ;
    myCurve1.clear ( );
    myCurve2.clear ( );
    for ( Iterator3D it = myBegin; it != myEnd; ++it )
    {
      myCurve1.push_back ( myProj1 ( *it ) );
      myCurve2.push_back ( myProj2 ( *it ) );
    }
  }

  // No extension: the range is its own context.
  template < typename Iterator3D, typename Functor, typename LambdaFunctor, int CONNECTIVITY >
  inline
  void
  LambdaMST3DBy2DEstimator< Iterator3D, Functor, LambdaFunctor, CONNECTIVITY >::init ( Iterator3D itB, Iterator3D itE,
                                                                                        MAIN_AXIS axis )
  {
    init ( itB, itE, itB, itE, axis );
  }

  template < typename Iterator3D, typename Functor, typename LambdaFunctor, int CONNECTIVITY >
  inline
  bool
  LambdaMST3DBy2DEstimator< Iterator3D, Functor, LambdaFunctor, CONNECTIVITY >::isValid ( ) const
  {
    return ( myCoreBegin != myCoreEnd );
  }

  template < typename Iterator3D, typename Functor, typename LambdaFunctor, int CONNECTIVITY >
  template < typename OutputIterator >
  inline
  OutputIterator
  LambdaMST3DBy2DEstimator< Iterator3D, Functor, LambdaFunctor, CONNECTIVITY >::eval ( Iterator3D itb, Iterator3D ite,
                                                                                       OutputIterator result )
  {
    assert ( isValid() && myCoreBegin <= itb && ite <= myCoreEnd && itb != ite );
    std::vector < RealVector2D > tangent1;
    std::vector < RealVector2D > tangent2;

    // [itb, ite) in the projected contexts.
    const auto len = std::distance ( itb, ite );
    const auto off = std::distance ( myBegin, itb );
    Estimate2DTangent ( myCurve1.cbegin ( ), myCurve1.cend ( ),
                        myCurve1.cbegin ( ) + off, myCurve1.cbegin ( ) + off + len, std::back_inserter ( tangent1 ) );
    Estimate2DTangent ( myCurve2.cbegin ( ), myCurve2.cend ( ),
                        myCurve2.cbegin ( ) + off, myCurve2.cbegin ( ) + off + len, std::back_inserter ( tangent2 ) );

    // Composing the two 2D tangents fixes a direction but not a sign: with
    // 2D tangents (q_x, q_y) and (r_x, r_z), the composed vector is
    // proportional to (1, q_y / q_x, r_z / r_x), and multiplying it out to
    // (q_x r_x, q_y r_x, q_x r_z) leaves the sign of q_x r_x to whatever the
    // two 2D estimates happened to return. Every tangent is therefore
    // oriented along the traversal: the curve advances monotonically along
    // myAxis, so the sign of that advance is the sign the tangent's main
    // component must carry.
    const int forward = traversalSign ( );
    for ( auto it = itb; it < ite; ++it )
    {
      RealVector3D t = myFunctor ( myAxis, tangent1[std::distance ( itb, it )], tangent2[std::distance ( itb, it )] );
      if ( t[ (Dimension) myAxis ] * forward < 0. )
        t = -t;
      result++ = t;
    }

    return result;
  }

  // +1 if the context advances along its main axis, -1 if it recedes. The
  // context is functional along the axis (see init()) and contains the
  // reported range, so its first and last points give the direction of
  // both. A context of one point has no direction: +1.
  template < typename Iterator3D, typename Functor, typename LambdaFunctor, int CONNECTIVITY >
  inline
  int
  LambdaMST3DBy2DEstimator< Iterator3D, Functor, LambdaFunctor, CONNECTIVITY >::traversalSign ( ) const
  {
    if ( std::distance ( myBegin, myEnd ) < 2 )
      return 1;
    const Dimension axis = (Dimension) myAxis;
    return ( (*( myEnd - 1 ))[ axis ] > (*myBegin)[ axis ] ) ? 1 : -1;
  }

  // [ctxb,ctxe) is the projected context, [coreb,coree) the sub-range whose
  // points get a tangent.
  //
  // The tangential cover is computed on the whole context, so its maximal
  // segments are maximal in the context and are not cut at coreb or coree;
  // only those meeting [coreb,coree) are used. Only points of [coreb,coree)
  // get an estimate; the other points of the context only shape the maximal
  // segments.
  template < typename Iterator3D, typename Functor, typename LambdaFunctor, int CONNECTIVITY >
  template < typename OutputIterator >
  inline
  OutputIterator
  LambdaMST3DBy2DEstimator< Iterator3D, Functor, LambdaFunctor, CONNECTIVITY >::Estimate2DTangent
          ( TCurve2D::const_iterator ctxb, TCurve2D::const_iterator ctxe,
            TCurve2D::const_iterator coreb, TCurve2D::const_iterator coree, OutputIterator result )
  {
    Segmentation2D segmentation ( ctxb, ctxe, SegmentComputer2D ( ) );
    Value2DFunctor functor;
    std::vector < Value2D > acc ( std::distance ( coreb, coree ) );

    for ( auto iseq = segmentation.begin ( ); iseq != segmentation.end ( ); ++iseq )
    {
      const SegmentComputer2D & dss = *iseq;
      if ( dss.end ( ) <= coreb || dss.begin ( ) >= coree )
        continue; // does not meet the core
      int dssLen = (int)std::distance ( dss.begin ( ), dss.end ( ) );
      int idx = 0;
      for ( auto pit = dss.begin ( ); pit != dss.end ( ); ++pit, ++idx )
      {
        if ( pit >= coreb && pit < coree )
          acc[ std::distance ( coreb, pit ) ] += functor ( dss, idx + 1, dssLen + 1 );
      }
    }

    for ( auto & v : acc )
    {
      if ( v.second != 0. )
        *result++ = v.first / v.second;
      else
        *result++ = v.first;
    }
    return result;
  }
}

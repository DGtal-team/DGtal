}

//-----------------------------------------------------------------
template <typename TIterator, typename TInteger, bool isDirect, typename TCategory>
inline
bool
DGtal::ArithmeticalDSSComputerOnArrows<TIterator,TInteger,isDirect,TCategory>::isValid() const
{
  return ( (myDSS.isValid())&&(isNotEmpty(myBegin,myEnd)) );
}

//-----------------------------------------------------------------
template <typename TIterator, typename TInteger, bool isDirect, typename TCategory>
inline
void
DGtal::ArithmeticalDSSComputerOnArrows<TIterator,TInteger,isDirect,TCategory>::selfDisplay ( std::ostream & out) const
{
  out << "[ArithmeticalDSSComputerOnArrows] " << myDSS;
}

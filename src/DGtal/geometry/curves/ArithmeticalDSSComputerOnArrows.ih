}

//-------------------------------------------------------------------------
template <typename TIterator, typename TInteger, bool isDirect, typename TCategory>
inline
typename DGtal::ArithmeticalDSSComputerOnArrows<TIterator,TInteger,isDirect,TCategory>::ConstIterator
DGtal::ArithmeticalDSSComputerOnArrows<TIterator,TInteger,isDirect,TCategory>::end() const
{

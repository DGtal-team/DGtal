\image html normals-convergence-flower.png "Mean angular error (radian) of the normal estimators along the boundary of a digitized flower as a function of the grid step h." width=70%
\image html normals-max-error-flower.png "Maximal angular error (radian) of the normal estimators along the boundary of a digitized flower as a function of the grid step h." width=70%
\image html normals-timings.png "Running times (ms) of the normal estimators along the boundary of a digitized flower as a function of the number of points." width=70%

*/

}
